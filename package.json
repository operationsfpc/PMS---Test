{
  "name": "fpc-pms",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "FACE Prep Campus — Placement Management System",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest",
    "test:run": "vitest run",
    "test:cov": "vitest run --coverage",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "typecheck": "tsc -b --noEmit",
    "check": "pnpm lint && pnpm typecheck && pnpm test:cov"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.6",
    "@types/node": "^26.1.2",
    "@vitest/coverage-v8": "^4.1.10",
    "lefthook": "^2.1.10",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
