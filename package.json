{
  "name": "fpc-pms",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "FACE Prep Campus — Placement Management System",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest",
    "test:run": "vitest run",
    "test:cov": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "typecheck": "tsc -b --noEmit",
    "check": "pnpm lint && pnpm typecheck && pnpm test:cov",
    "db:types": "node --experimental-strip-types scripts/gen-types.mjs",
    "db:setup": "node --experimental-strip-types scripts/setup-database.ts",
    "db:bundle": "node --experimental-strip-types scripts/setup-database.ts --bundle-only",
    "db:push": "supabase db push",
    "cf:dev": "pnpm build && wrangler dev",
    "deploy": "pnpm build && wrangler deploy",
    "build:test": "vite build --mode test",
    "deploy:test": "pnpm build:test && wrangler deploy --env test"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.6",
    "@electric-sql/pglite": "^0.5.4",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitest/coverage-v8": "^4.1.10",
    "jsdom": "^30.0.1",
    "lefthook": "^2.1.10",
    "msw": "^2.15.0",
    "supabase": "^2.111.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.2.0",
    "vitest": "^4.1.10",
    "wrangler": "^4.118.0"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.5.7",
    "@supabase/supabase-js": "^2.111.0",
    "exceljs": "^4.4.0",
    "jszip": "^3.10.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.83.0",
    "react-router": "^8.3.0",
    "zod": "^4.4.3"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
